[Unit]
Description=Hyperspace trading latency probe agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hyperspace-probe
Group=hyperspace-probe
EnvironmentFile=/etc/hyperspace/trading-probe-agent.env
ExecStart=/usr/local/bin/hyperspace-trading-probe-agent
Restart=always
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
StateDirectory=hyperspace-trading-probe
StateDirectoryMode=0750
LogsDirectory=hyperspace-trading-probe
LogsDirectoryMode=0750
MemoryMax=256M
CPUQuota=25%
TasksMax=64

[Install]
WantedBy=multi-user.target
