[Unit]
Description=Hyperspace Gate Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/
EnvironmentFile=/etc/hyperspace/gate-agent.env
ExecStart=/usr/local/bin/hyperspace-gate-agent
StateDirectory=hyperspace-gate
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
