[Unit]
Description=Hyperspace Gate Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/2z-wireguard-vpn/apps/gate-agent
EnvironmentFile=/etc/hyperspace/gate-agent.env
ExecStart=/usr/local/bin/hyperspace-gate-agent
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
