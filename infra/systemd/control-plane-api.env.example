HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://hyperspace:replace@db.testnet.hyperspace.zone:5432/hyperspace
AUTH_SESSION_TTL_SECONDS=2592000
ARTIFACT_DOWNLOAD_TTL_SECONDS=300
GATE_AGENT_RELEASE_DIR=/var/lib/hyperspace/gate-agent-releases
ADMIN_TOKEN=replace-with-random-token
ARTIFACT_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
CUSTODIAL_WALLET_ENCRYPTION_KEY=replace-with-separate-32-byte-base64url-key
# Non-resolving placeholder. Inject the real mainnet-backed staging/production
# value through runtime configuration or secret management. Solana testnet must
# use a separate testnet RPC.
SOLANA_RPC_URL=replace-with-environment-specific-solana-rpc-url
# Reserved placeholder for future consumers; the API currently uses HTTP only.
# SOLANA_RPC_WS_URL=wss://solana-rpc.example.invalid
SOLANA_ASSET_KIND=native
SOLANA_TOKEN_MINT=native
SOLANA_TOKEN_SYMBOL=SOL
SOLANA_TOKEN_BASE_UNITS_PER_BILLING_MINOR=1
SOLANA_TOKEN_DECIMALS=9
SOLANA_EXPLORER_TX_BASE_URL=https://orbmarkets.io/tx/
BILLING_CURRENCY=SOL
SOLANA_CONFIG_PAYMENT_ENABLED=true
SOLANA_CONFIG_PRICE_LAMPORTS=100000
SOLANA_REVENUE_TREASURY_ADDRESS=replace-with-platform-solana-wallet
