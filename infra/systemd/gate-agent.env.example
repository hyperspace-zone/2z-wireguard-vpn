CONTROL_PLANE_URL=https://control-plane.testnet.hyperspace.zone
GATE_NAME=gate-eu-fra-01
GATE_TOKEN=replace-with-issued-gate-token
POLL_INTERVAL=2s
HEARTBEAT_INTERVAL=10s
GATE_AGENT_EXECUTION_MODE=apply
GATE_AGENT_STATE_DIR=/var/lib/hyperspace-gate
GATE_PROBE_LISTEN_ADDRESS=0.0.0.0
GATE_PROBE_PORT=19192
GATE_PROBE_SHARED_SECRET=replace-with-shared-random-secret-across-gates
