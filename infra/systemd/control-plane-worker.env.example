WORKER_OBSERVABILITY_HOST=0.0.0.0
WORKER_OBSERVABILITY_PORT=9091
ARTIFACT_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
# Non-resolving placeholder. Inject a history-capable mainnet-backed
# staging/production value through runtime configuration or secret management.
# Deposit discovery requires getSignaturesForAddress, getSignatureStatuses and
# getTransaction. Solana testnet must use a separate testnet RPC.
SOLANA_RPC_URL=replace-with-environment-specific-solana-rpc-url
