WORKER_POLL_MS=2000
BENCHMARK_SCHEDULER_POLL_MS=15000
WORKER_SNAPSHOT_INTERVAL_MS=15000
WORKER_ID=control-plane-worker-01
RETAIL_BILLING_ENABLED=false
RETAIL_BILLING_MODE=shadow
RETAIL_BILLING_INTERVAL_SECONDS=300
RETAIL_BILLING_SETTLEMENT_LAG_SECONDS=120
RETAIL_BILLING_BATCH_SIZE=250
