# Separate optional worker, no wallet/payment/encryption secrets.
PROBES_BACKEND=mongodb
PROBES_CATALOG_DATABASE_URL=postgres://hyperspace_catalog_reader:replace@db.example.invalid:5432/hyperspace
MEASUREMENTS_MONGO_URL=mongodb://probe-user:replace@db-mongo.example.invalid/hyperspace_measurements
MEASUREMENTS_MONGO_CA_FILE=/etc/hyperspace/mongodb/ca.crt
PROBES_OBSERVABILITY_HOST=127.0.0.1
PROBES_OBSERVABILITY_PORT=9092
BENCHMARK_PROBES_ENABLED=true
BENCHMARK_INTERVAL_SECONDS=300
BENCHMARK_PROBE_PORT=19192
BENCHMARK_PROBE_COUNT=10
BENCHMARK_PROBE_INTERVAL_MS=100
BENCHMARK_PROBE_TIMEOUT_MS=1000
TRADING_PROBES_ENABLED=true
NTP_DISCOVERY_ENABLED=false
