# Official Cloudflare ranges checked 2026-10-07; refresh alongside Caddy policy.
# Do not enable until app.hyperspace.zone is proxied. No global flush or SSH change.
table inet hyperspace_web_origin {
  set cf4 {
    type ipv4_addr
    flags interval
    elements = { 173.245.48.0/20, 103.21.244.0/22, 103.22.200.0/22, 103.31.4.0/22,
      141.101.64.0/18, 108.162.192.0/18, 190.93.240.0/20, 188.114.96.0/20,
      197.234.240.0/22, 198.41.128.0/17, 162.158.0.0/15, 104.16.0.0/13,
      104.24.0.0/14, 172.64.0.0/13, 131.0.72.0/22 }
  }
  set cf6 {
    type ipv6_addr
    flags interval
    elements = { 2400:cb00::/32, 2606:4700::/32, 2803:f800::/32, 2405:b500::/32,
      2405:8100::/32, 2a06:98c0::/29, 2c0f:f248::/32 }
  }
  chain input {
    type filter hook input priority -5; policy accept;
    iifname "lo" accept
    # Keep only the current observability host's direct health checks.
    ip saddr { 84.32.83.71, 10.179.228.19 } tcp dport { 80, 443 } accept
    ip saddr @cf4 tcp dport { 80, 443 } accept
    ip6 saddr @cf6 tcp dport { 80, 443 } accept
    ip saddr @cf4 udp dport 443 accept
    ip6 saddr @cf6 udp dport 443 accept
    tcp dport { 80, 443 } drop
    udp dport 443 drop
  }
}
