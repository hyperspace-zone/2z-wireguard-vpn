{
  email ops@hyperspace.zone
  log {
    format filter {
      wrap json
      fields {
        request>headers delete
        resp_headers delete
        request>uri regexp "([?].*|/artifacts/download/[^/?]+)" "[redacted]"
      }
    }
  }
}

(hyperspace_api_proxy) {
  reverse_proxy https://control-plane.hyperspace.zone {
    header_up Host control-plane.hyperspace.zone
    header_up X-Forwarded-For {args[0]}
    header_up -X-Real-IP
    header_up -CF-Connecting-IP
  }
}

http://app.hyperspace.zone {
  # Automatic HTTP redirects otherwise bypass the HTTPS auth-only log matcher.
  skip_log
  redir https://app.hyperspace.zone{uri} permanent
}

app.hyperspace.zone {
  encode zstd gzip
  # Caddy 2.6-compatible: retain auth access metadata only, never headers/query values.
  @non_auth not path /api/v1/public/auth/*
  skip_log @non_auth
  log {
    output file /var/log/caddy/auth-access.json {
      roll_size 10MiB
      roll_keep 10
      roll_keep_for 168h
    }
    format filter {
      wrap json
      fields {
        request>headers delete
        resp_headers delete
        request>uri regexp "[?].*$" ""
      }
    }
  }
  handle /api/* {
    @private_api not path /api/v1/public/benchmarks/gate-matrix /api/v1/public/trading/latency
    header @private_api Cache-Control "no-store, max-age=0"
    # Official ranges: https://www.cloudflare.com/ips-v4 and /ips-v6.
    # Caddy 2.6-compatible: never trust CF-Connecting-IP from a direct visitor.
    @from_cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    route {
      uri strip_prefix /api
      handle @from_cloudflare {
        import hyperspace_api_proxy {http.request.header.CF-Connecting-IP}
      }
      handle {
        import hyperspace_api_proxy {remote_host}
      }
    }
  }
  handle /assets/* {
    root * /var/www/hyperspace-web
    @existing_asset file {path}
    header @existing_asset Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /var/www/hyperspace-web
    header Cache-Control "no-store, max-age=0"
    try_files {path} /index.html
    file_server
  }
}
