# Combined web UI + control-plane API host.
# Use this for small deployments where static web assets and the API process run
# on the same server.
# Required environment:
# - APP_HOST: public DNS name or public IP address.
# - TLS_FULLCHAIN: path to fullchain.pem copied from Let's Encrypt.
# - TLS_PRIVKEY: path to privkey.pem copied from Let's Encrypt.
{
	auto_https disable_redirects
}

:80 {
	@acme path /.well-known/acme-challenge/*
	handle @acme {
		root * /var/www/acme-challenges
		file_server
	}

	handle {
		redir https://{host}{uri} permanent
	}
}

https://${APP_HOST} {
	tls ${TLS_FULLCHAIN} ${TLS_PRIVKEY}
	encode zstd gzip

	handle /api/* {
		header Cache-Control "no-store, max-age=0"
		uri strip_prefix /api
		reverse_proxy 127.0.0.1:8080
	}

	handle /v1/* {
		header Cache-Control "no-store, max-age=0"
		reverse_proxy 127.0.0.1:8080
	}

	handle /health {
		reverse_proxy 127.0.0.1:8080
	}

	handle /assets/* {
		root * /var/www/hyperspace-web
		@existing_asset file {path}
		header @existing_asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /var/www/hyperspace-web
		header Cache-Control "no-store, max-age=0"
		try_files {path} /index.html
		file_server
	}
}
