{{ define "telegram.hyperspace.alert" -}}
<b>{{ .Labels.alertname | html }}</b>
{{ if .Labels.severity }}severity <b>{{ .Labels.severity | html }}</b>
{{ end -}}
{{ if .Labels.cluster }}cluster <b>{{ .Labels.cluster | html }}</b>
{{ end -}}
{{ if .Labels.gate }}gate <b>{{ .Labels.gate | html }}</b>
{{ end -}}
{{ if .Labels.route }}route <b>{{ .Labels.route | html }}</b>
{{ end -}}
{{ if .Labels.transport }}transport <b>{{ .Labels.transport | html }}</b>
{{ end -}}
started UTC <code>{{ .StartsAt.UTC.Format "2006-01-02T15:04:05Z" }}</code>
{{ if eq .Status "resolved" -}}
resolved UTC <code>{{ .EndsAt.UTC.Format "2006-01-02T15:04:05Z" }}</code>
{{ end -}}
{{ if .Labels.route -}}
{{ if or .Labels.source_probe_host .Labels.source_public_ipv4 -}}
Source gate access:
{{ if .Labels.source_gate }}gate <code>{{ .Labels.source_gate | html }}</code>
{{ end -}}
{{ if .Labels.source_probe_host }}host <code>{{ .Labels.source_probe_host | html }}</code>
{{ end -}}
{{ if .Labels.source_public_ipv4 }}ip <code>{{ .Labels.source_public_ipv4 | html }}</code>
{{ end -}}
{{ end -}}
{{ if or .Labels.target_probe_host .Labels.target_public_ipv4 -}}
Target gate access:
{{ if .Labels.target_gate }}gate <code>{{ .Labels.target_gate | html }}</code>
{{ end -}}
{{ if .Labels.target_probe_host }}host <code>{{ .Labels.target_probe_host | html }}</code>
{{ end -}}
{{ if .Labels.target_public_ipv4 }}ip <code>{{ .Labels.target_public_ipv4 | html }}</code>
{{ end -}}
{{ end -}}
{{ else if or .Labels.probe_host .Labels.public_ipv4 -}}
Gate access:
{{ if .Labels.probe_host }}host <code>{{ .Labels.probe_host | html }}</code>
{{ end -}}
{{ if .Labels.public_ipv4 }}ip <code>{{ .Labels.public_ipv4 | html }}</code>
{{ end -}}
{{ else if or .Labels.service_host .Labels.service_ipv4 -}}
Service access:
{{ if .Labels.role }}role <code>{{ .Labels.role | html }}</code>
{{ end -}}
{{ if .Labels.service_host }}host <code>{{ .Labels.service_host | html }}</code>
{{ end -}}
{{ if .Labels.service_ipv4 }}ip <code>{{ .Labels.service_ipv4 | html }}</code>
{{ end -}}
{{ end -}}
{{ .Annotations.summary | html }}
{{ .Annotations.description | html }}
{{ end -}}

{{ define "telegram.hyperspace.message" -}}
{{ $firing := .Alerts.Firing -}}
{{ $resolved := .Alerts.Resolved -}}
{{ if gt (len $firing) 0 -}}
<b>FIRING</b> {{ len $firing }} Hyperspace alert(s)
{{ range $firing }}

{{ template "telegram.hyperspace.alert" . }}
{{ end }}
{{ end -}}
{{ if gt (len $resolved) 0 -}}
{{ if gt (len $firing) 0 }}
{{ end }}<b>RESOLVED</b> {{ len $resolved }} Hyperspace alert(s)
{{ range $resolved }}

{{ template "telegram.hyperspace.alert" . }}
{{ end }}
{{ end -}}
{{- end }}
