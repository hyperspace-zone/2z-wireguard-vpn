{{ define "telegram.hyperspace.alert" -}}
<b>{{ .Labels.alertname | html }}</b>{{ if .Labels.severity }} severity=<b>{{ .Labels.severity | html }}</b>{{ end }}{{ if .Labels.cluster }} cluster=<b>{{ .Labels.cluster | html }}</b>{{ end }}{{ if .Labels.gate }} gate=<b>{{ .Labels.gate | html }}</b>{{ end }}{{ if .Labels.route }} route=<b>{{ .Labels.route | html }}</b>{{ end }}{{ if .Labels.transport }} transport=<b>{{ .Labels.transport | html }}</b>{{ end }}
{{ if or .Labels.probe_host .Labels.public_ipv4 -}}
Gate access:
{{ if .Labels.probe_host }}host <code>{{ .Labels.probe_host | html }}</code>
{{ end -}}
{{ if .Labels.public_ipv4 }}ip <code>{{ .Labels.public_ipv4 | html }}</code>
{{ end -}}
{{ end -}}
{{ .Annotations.summary | html }}
{{ .Annotations.description | html }}
{{ end -}}

{{ define "telegram.hyperspace.message" -}}
{{ $firing := .Alerts.Firing -}}
{{ $resolved := .Alerts.Resolved -}}
{{ if gt (len $firing) 0 -}}
<b>FIRING</b> {{ len $firing }} Hyperspace alert(s)
{{ range $firing }}

{{ template "telegram.hyperspace.alert" . }}
{{ end }}
{{ end -}}
{{ if gt (len $resolved) 0 -}}
{{ if gt (len $firing) 0 }}
{{ end }}<b>RESOLVED</b> {{ len $resolved }} Hyperspace alert(s)
{{ range $resolved }}

{{ template "telegram.hyperspace.alert" . }}
{{ end }}
{{ end -}}
{{- end }}
