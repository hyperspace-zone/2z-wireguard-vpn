HS_META_CLUSTER=staging
HS_META_TELEGRAM_BOT_TOKEN_FILE=/etc/hyperspace/meta-watch-telegram-bot-token
HS_META_TELEGRAM_CHAT_ID=366795
HS_META_TELEGRAM_USERNAME=HyperspaceMetaWatcher_bot
HS_META_RESEND_API_KEY_FILE=/etc/hyperspace/meta-watch-resend-api-key
HS_META_EMAIL_FROM="Hyperspace <no-reply@hyperspace.zone>"
HS_META_EMAIL_TO=gatekeepers@hyperspace.zone
HS_META_PRIMARY_TELEGRAM_BOT_TOKEN_FILE=/etc/prometheus/telegram_bot_token
HS_META_PRIMARY_RECEIVERS_FILE=/etc/prometheus/alertmanager_telegram_receivers.json
HS_META_PRIMARY_TELEGRAM_USERNAME=HyperspaceStagingWatcher_bot
HS_META_ALERTMANAGER_URL=http://127.0.0.1:9093
HS_META_PEERS_FILE=/etc/hyperspace/meta-watch-peers.tsv
HS_META_STATE_DIR=/var/lib/hyperspace/meta-watch
HS_META_METRICS_DIR=/var/lib/prometheus/node-exporter
HS_META_FAILURE_THRESHOLD=2
HS_META_RECOVERY_THRESHOLD=2
HS_META_NOTIFICATION_FAILURE_HOLD_SECONDS=600
