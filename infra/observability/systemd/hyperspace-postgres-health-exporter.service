[Unit]
Description=Export Hyperspace PostgreSQL health and backup metrics
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=-/etc/hyperspace/postgres-monitoring.env
ExecStart=/usr/local/sbin/hyperspace-postgres-health-exporter
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=-/var/backups/hyperspace
ReadOnlyPaths=-/var/lib/hyperspace/db-backup
ReadWritePaths=/var/lib/node_exporter/textfile_collector
