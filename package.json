{
  "name": "@hyperspace-zone/2z-wireguard-vpn",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/shared",
    "packages/db",
    "packages/control-plane",
    "apps/control-plane-api",
    "apps/control-plane-worker",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run build -w @hyperspace-zone/db && node packages/db/dist/migrate.js",
    "db:seed:gates": "npm run build -w @hyperspace-zone/db && node packages/db/dist/seed-gates.js",
    "db:seed:gates:json": "scripts/seed-gates-json",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present",
    "test:milestone3:ui": "node scripts/testnet/milestone3-ui-smoke.mjs",
    "test:live:email": "node --env-file-if-exists=.env scripts/testnet/resend-otp-e2e.mjs",
    "test:live:identity-db": "node --env-file-if-exists=.env scripts/testnet/identity-linking-db-e2e.mjs",
    "test:live:billing-db": "node --env-file-if-exists=.env scripts/testnet/milestone3-billing-db-e2e.mjs",
    "test:live:billing-ui": "node --env-file-if-exists=.env scripts/testnet/retail-billing-ui-e2e.mjs",
    "test:live:ui": "node --env-file-if-exists=.env scripts/testnet/live-ui-smoke.mjs",
    "test:live:policy": "node --env-file-if-exists=.env scripts/testnet/live-policy-smoke.mjs",
    "test:live:staging-gate-selector": "node scripts/live/gate-selector-ui-smoke.mjs",
    "test:live": "npm run test:live:ui && npm run test:live:policy",
    "gates:rollout-wave": "node scripts/gates/rollout-wave.mjs",
    "test:gate-discovery": "node --test scripts/observability/render-gate-file-sd.test.mjs",
    "test:gate-provisioning": "node --test scripts/gates/*.test.mjs",
    "measure:matrix": "python3 scripts/testnodes/run_measurement_matrix.py",
    "measure:compare": "python3 scripts/testnodes/compare_measurements.py",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.60.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "DoubleZero WireGuard VPN is a self-service control plane for issuing WireGuard configs that route traffic through DoubleZero-backed gate servers.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "abstract-logging": "^2.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "atomic-sleep": "^1.0.0",
    "avvio": "^9.2.0",
    "cookie": "^1.1.1",
    "dequal": "^2.0.3",
    "fast-decode-uri-component": "^1.0.1",
    "fast-deep-equal": "^3.1.3",
    "fast-json-stringify": "^6.4.0",
    "fast-querystring": "^1.1.2",
    "fast-uri": "^3.1.2",
    "fastify": "^5.8.5",
    "fastq": "^1.20.1",
    "find-my-way": "^9.6.0",
    "ipaddr.js": "^2.4.0",
    "json-schema-ref-resolver": "^3.0.0",
    "json-schema-traverse": "^1.0.0",
    "light-my-request": "^6.6.0",
    "on-exit-leak-free": "^2.1.2",
    "pg": "^8.21.0",
    "pg-cloudflare": "^1.4.0",
    "pg-connection-string": "^2.13.0",
    "pg-int8": "^1.0.1",
    "pg-pool": "^3.14.0",
    "pg-protocol": "^1.14.0",
    "pg-types": "^2.2.0",
    "pgpass": "^1.0.5",
    "pino": "^10.3.1",
    "pino-abstract-transport": "^3.0.0",
    "pino-std-serializers": "^7.1.0",
    "postgres-array": "^2.0.0",
    "postgres-bytea": "^1.0.1",
    "postgres-date": "^1.0.7",
    "postgres-interval": "^1.2.0",
    "process-warning": "^5.0.0",
    "quick-format-unescaped": "^4.0.4",
    "real-require": "^0.2.0",
    "require-from-string": "^2.0.2",
    "ret": "^0.5.0",
    "reusify": "^1.1.0",
    "rfdc": "^1.4.1",
    "safe-regex2": "^5.1.1",
    "safe-stable-stringify": "^2.5.0",
    "secure-json-parse": "^4.1.0",
    "semver": "^7.8.1",
    "set-cookie-parser": "^2.7.2",
    "sonic-boom": "^4.2.1",
    "split2": "^4.2.0",
    "thread-stream": "^4.2.0",
    "toad-cache": "^3.7.1",
    "undici-types": "^7.16.0",
    "xtend": "^4.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperspace-zone/2z-wireguard-vpn.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/hyperspace-zone/2z-wireguard-vpn/issues"
  },
  "homepage": "https://github.com/hyperspace-zone/2z-wireguard-vpn#readme"
}
