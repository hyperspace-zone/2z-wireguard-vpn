#!/usr/bin/env bash
set -euo pipefail
[[ $(id -u) == 0 && "${HS_PROBES_CUTOVER_CONFIRMED:-}" == 1 ]] || { echo 'Explicit verified cutover confirmation required'; exit 2; }
script_dir="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$script_dir/../.." && pwd)"
dump=/mnt/hyperspace-backup/postgresql/hyperspace-before-db-isolation-20261006.dump
expected=960dcf664a3da19e569b13943d148033b99804c3a9968c832ffe423c33aeccb4
actual="$(runuser -u postgres -- sha256sum "$dump" | awk '{print $1}')"
[[ "$actual" == "$expected" ]] || { echo 'Pre-cutover snapshot missing or invalid'; exit 1; }
runuser -u postgres -- pg_restore --list "$dump" >/dev/null
printf '%s\n' "$expected" | runuser -u postgres -- tee "${dump}.sha256" >/dev/null
runuser -u postgres -- chmod 0600 "$dump" "${dump}.sha256"
rows="$(runuser -u postgres -- psql -X -p 5433 -d hyperspace_probes -Atc 'SELECT count(*) FROM trading_latency_latest')"
[[ "$rows" =~ ^[0-9]+$ && "$rows" -gt 0 ]] || { echo 'No preserved measurements in probes'; exit 1; }
systemctl stop hyperspace-db-history-archive.timer hyperspace-db-history-archive.service
restart_archive() { systemctl start hyperspace-db-history-archive.timer; }
trap restart_archive EXIT
# These exact measurement tables are recoverable from the verified full dump.
# Small core-owned node/target/token configuration is deliberately preserved.
runuser -u postgres -- psql -X -v ON_ERROR_STOP=1 -d hyperspace <<'SQL'
SET lock_timeout='1s';
SET statement_timeout='30s';
TRUNCATE gate_benchmark_results,trading_probe_jobs,trading_probe_job_attempts,
  trading_latency_latest,trading_latency_rollups,trading_probe_leases,trading_probe_node_status;
SQL
while true; do
  removed="$(runuser -u postgres -- psql -X -At -v ON_ERROR_STOP=1 -d hyperspace -c "SET lock_timeout='500ms'; WITH removed AS (DELETE FROM jobs WHERE id IN (SELECT id FROM jobs WHERE type='probe' ORDER BY id LIMIT 1000) RETURNING id) SELECT count(*) FROM removed;" | tail -n 1)"
  [[ "$removed" =~ ^[0-9]+$ ]] || exit 1
  [[ "$removed" != 0 ]] || break
done
runuser -u postgres -- psql -X -1 -v ON_ERROR_STOP=1 -d hyperspace -f "$script_dir/activate-core-isolation.sql"
for name in hyperspace-pg-backup hyperspace-pg-history-archive hyperspace-pg-restore-core hyperspace-pg-restore-check; do
  install -m 0755 "$script_dir/$name" "/usr/local/sbin/$name"
done
for pair in 'db-backup.env:HS_DB_BACKUP_PROFILE' 'db-history-archive.env:HS_DB_HISTORY_ARCHIVE_PROFILE'; do
  file="/etc/hyperspace/${pair%%:*}"; variable="${pair#*:}"
  cp -p "$file" "${file}.before-db-isolation-20261006"
  awk -v prefix="${variable}=" 'index($0,prefix)!=1' "$file" >"${file}.isolation.tmp"
  printf '%s=core\n' "$variable" >>"${file}.isolation.tmp"
  install -m 0600 "${file}.isolation.tmp" "$file"
  unlink "${file}.isolation.tmp"
done
install -d -o postgres -g postgres -m 0700 /var/lib/hyperspace/db-restore-check
install -m 0644 "$root/infra/systemd/hyperspace-db-restore-check.service" "$root/infra/systemd/hyperspace-db-restore-check.timer" /etc/systemd/system/
systemctl daemon-reload
systemctl enable hyperspace-db-restore-check.timer
systemctl start hyperspace-db-backup.service
systemctl start hyperspace-db-restore-check.service
systemctl start hyperspace-db-restore-check.timer
runuser -u postgres -- psql -X -d hyperspace -c "SELECT pg_size_pretty(pg_database_size(current_database())) AS core_size; SELECT count(*) AS users FROM users; SELECT count(*) AS sessions FROM sessions; SELECT entry_type,currency,count(*),sum(amount_minor) FROM balance_ledger_entries GROUP BY 1,2;"
echo 'Core isolated, updated backup created and full restore drill completed.'
