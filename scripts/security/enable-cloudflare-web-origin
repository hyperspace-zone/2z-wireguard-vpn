#!/usr/bin/env bash
# Run ON THE WEB HOST only after DNS proxy is enabled and checked.
# This independent nft table restricts only public HTTP(S)/QUIC, not SSH,
# WireGuard, node exporter, other hosts or existing firewall policy.
set -euo pipefail
[[ $(id -u) == 0 ]] || { echo 'Root required.' >&2; exit 2; }
[[ "${1:-}" == --proxy-verified ]] || { echo 'Enable app Cloudflare proxy first; then pass --proxy-verified.' >&2; exit 2; }
repo="$(cd "$(dirname "$0")/../.." && pwd)"
config="$repo/infra/security/cloudflare-web-origin.nft"
[[ -f "$config" ]] || exit 2
ip -4 addr show | grep -q '84[.]32[.]83[.]69/' || { echo 'This installer is only for production web 84.32.83.69.' >&2; exit 2; }
# CIDR validation uses numeric IPs, never substring checks. Refuse stale DNS or
# a mixed proxied/direct answer, so enabling protection cannot cut off the site.
python3 - <<'PY'
import ipaddress, socket
allowed = [ipaddress.ip_network(x) for x in '''173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22'''.split()]
addresses = {row[4][0] for row in socket.getaddrinfo('app.hyperspace.zone', 443, socket.AF_INET)}
if not addresses or not all(any(ipaddress.ip_address(ip) in net for net in allowed) for ip in addresses):
    raise SystemExit('Refusing: app DNS is not entirely proxied through Cloudflare yet.')
print('DNS proxy verified; configuring only this web host HTTP(S) origin.')
PY
command -v nft >/dev/null || { apt-get update; apt-get install -y nftables; }
nft list table inet hyperspace_web_origin >/dev/null 2>&1 && { echo 'Origin guard already exists; do not overwrite manually modified rules.' >&2; exit 2; }
nft --check --file "$config"
install -d -m 0755 /etc/hyperspace
install -m 0644 "$config" /etc/hyperspace/cloudflare-web-origin.nft
install -m 0644 "$repo/infra/systemd/hyperspace-web-origin.service" /etc/systemd/system/hyperspace-web-origin.service
systemctl daemon-reload
systemctl enable --now hyperspace-web-origin.service
echo 'Origin guard enabled. Rollback: systemctl disable --now hyperspace-web-origin.service'
