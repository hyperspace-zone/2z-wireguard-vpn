#!/usr/bin/env bash
set -euo pipefail

if [[ "${EUID}" -ne 0 ]]; then
  echo "Run this installer as root" >&2
  exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
for required_file in \
  /etc/hyperspace/meta-watch.env \
  /etc/hyperspace/meta-watch-telegram-bot-token \
  /etc/hyperspace/meta-watch-resend-api-key; do
  [[ -s "$required_file" ]] || {
    echo "$required_file is required" >&2
    exit 1
  }
done

install -d -o root -g root -m 0750 /etc/hyperspace
install -d -o root -g root -m 0700 /var/lib/hyperspace/meta-watch
install -d -o root -g root -m 0755 /var/lib/prometheus/node-exporter
chmod 0600 \
  /etc/hyperspace/meta-watch.env \
  /etc/hyperspace/meta-watch-telegram-bot-token \
  /etc/hyperspace/meta-watch-resend-api-key
install -o root -g root -m 0755 \
  "$repo_root/scripts/observability/hyperspace-meta-watch" \
  /usr/local/sbin/hyperspace-meta-watch
install -o root -g root -m 0644 \
  "$repo_root/infra/observability/systemd/hyperspace-meta-watch.service" \
  /etc/systemd/system/hyperspace-meta-watch.service
install -o root -g root -m 0644 \
  "$repo_root/infra/observability/systemd/hyperspace-meta-watch.timer" \
  /etc/systemd/system/hyperspace-meta-watch.timer

systemctl daemon-reload
systemctl enable --now hyperspace-meta-watch.timer
systemctl start hyperspace-meta-watch.service
systemctl is-active --quiet hyperspace-meta-watch.timer
