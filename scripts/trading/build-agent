#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
output=${1:-"${repo_root}/dist/hyperspace-trading-probe-agent"}
revision=$(git -C "${repo_root}" rev-parse HEAD)
built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
version=${TRADING_PROBE_AGENT_VERSION:-0.2.0}

mkdir -p "$(dirname "${output}")"
(
  cd "${repo_root}/apps/trading-probe-agent"
  CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -ldflags "-s -w -X main.version=${version} -X main.buildRevision=${revision} -X main.buildTime=${built_at}" \
    -o "${output}" \
    ./cmd/hyperspace-trading-probe-agent
)
chmod 0755 "${output}"
"${output}" --self-test >/dev/null
sha256sum "${output}"
