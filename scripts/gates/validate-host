#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: scripts/gates/validate-host --host HOST --doublezero-env testnet|mainnet-beta [options]

Options:
  --ssh-key PATH     SSH private key.
  --ssh-user USER    SSH user, default root.
  --known-hosts-file PATH  Pinned SSH known_hosts file, default ~/.ssh/known_hosts.
  --require-deployment-ready  Exit non-zero unless the agent service and artifact self-test pass.
  --dry-run          Print the SSH command instead of executing.
EOF
}

host=""
ssh_key=""
ssh_user="root"
known_hosts_file="${HOME}/.ssh/known_hosts"
dz_env=""
dry_run=false
require_deployment_ready=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) host="${2:-}"; shift 2 ;;
    --ssh-key) ssh_key="${2:-}"; shift 2 ;;
    --ssh-user) ssh_user="${2:-}"; shift 2 ;;
    --known-hosts-file) known_hosts_file="${2:-}"; shift 2 ;;
    --doublezero-env) dz_env="${2:-}"; shift 2 ;;
    --require-deployment-ready) require_deployment_ready=true; shift ;;
    --dry-run) dry_run=true; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage; exit 2 ;;
  esac
done

if [[ -z "$host" || -z "$dz_env" ]]; then
  usage
  exit 2
fi
if [[ "$dry_run" != true && ! -r "$known_hosts_file" ]]; then
  echo "known_hosts file is not readable: $known_hosts_file" >&2
  exit 2
fi

ssh_args=(-o StrictHostKeyChecking=yes -o UserKnownHostsFile="$known_hosts_file" -o ServerAliveInterval=15 -o ServerAliveCountMax=4)
if [[ -n "$ssh_key" ]]; then
  ssh_args+=(-i "$ssh_key")
fi

remote_script="$(cat <<'REMOTE'
set -euo pipefail
json_bool() { if "$@" >/dev/null 2>&1; then printf true; else printf false; fi; }
json_string() { python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip()))'; }
node_exporter_exposes_resource_metrics() {
  curl -fsS --max-time 5 http://127.0.0.1:9100/metrics \
    | awk '$1 == "hyperspace_gate_resource_exporter_last_run_timestamp_seconds" { found = 1 } END { exit !found }'
}
gate_firewall_rules_persisted() {
  systemctl is-enabled --quiet hyperspace-gate-firewall.service \
    && /usr/local/sbin/hyperspace-gate-firewall --check
}

hostname_value="$(hostname -f 2>/dev/null || hostname)"
kernel_value="$(uname -r)"
doublezero_status="$(doublezero --env "$DZ_ENV" --keypair /root/.config/doublezero/id.json status </dev/null 2>&1 || true)"
chrony_tracking="$(chronyc tracking 2>&1 || true)"
public_ipv4="$(curl -fsS4 https://api.ipify.org 2>/dev/null || true)"
physical_interface="$(ip -4 route show default | awk 'NR == 1 {for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}')"
conntrack_count="$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || printf 0)"
conntrack_max="$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null || printf 0)"
gate_tier="$(cat /etc/hyperspace/gate-tier 2>/dev/null || printf unknown)"
agent_release="$(/usr/local/sbin/hyperspace-gate-agent-release status 2>/dev/null || printf '{"status":"unavailable"}')"
if ! printf '%s' "$agent_release" | jq -e . >/dev/null 2>&1; then
  agent_release='{"status":"invalid_metadata"}'
fi

cat <<JSON
{
  "hostname": $(printf '%s' "$hostname_value" | json_string),
  "kernel": $(printf '%s' "$kernel_value" | json_string),
  "publicIpv4": $(printf '%s' "$public_ipv4" | json_string),
  "commands": {
    "doublezero": $(json_bool command -v doublezero),
    "wg": $(json_bool command -v wg),
    "ip": $(json_bool command -v ip),
    "nft": $(json_bool command -v nft),
    "chronyc": $(json_bool command -v chronyc),
    "caddy": $(json_bool command -v caddy),
    "vnstat": $(json_bool command -v vnstat),
    "nodeExporter": $(json_bool command -v prometheus-node-exporter),
    "hyperspaceGateAgent": $(json_bool command -v hyperspace-gate-agent),
    "hyperspaceGateAgentRelease": $(json_bool test -x /usr/local/sbin/hyperspace-gate-agent-release),
    "ufw": $(json_bool command -v ufw)
  },
  "services": {
    "doublezerod": $(json_bool systemctl is-active --quiet doublezerod),
    "hyperspaceGateAgent": $(json_bool systemctl is-active --quiet hyperspace-gate-agent),
    "chrony": $(json_bool systemctl is-active --quiet chrony),
    "caddy": $(json_bool systemctl is-active --quiet caddy),
    "vnstat": $(json_bool systemctl is-active --quiet vnstat),
    "nodeExporter": $(json_bool systemctl is-active --quiet prometheus-node-exporter),
    "diskJanitorTimer": $(json_bool systemctl is-active --quiet hyperspace-disk-janitor.timer),
    "resourceExporterTimer": $(json_bool systemctl is-active --quiet hyperspace-gate-resource-exporter.timer),
    "gateFirewallEnabled": $(json_bool systemctl is-enabled --quiet hyperspace-gate-firewall.service)
  },
  "gateAgent": {
    "artifactSelfTestPassed": $(json_bool /usr/local/bin/hyperspace-gate-agent --self-test),
    "release": ${agent_release}
  },
  "interfaces": {
    "doublezero0": $(json_bool ip link show doublezero0)
  },
  "resources": {
    "tier": $(printf '%s' "$gate_tier" | json_string),
    "physicalInterface": $(printf '%s' "$physical_interface" | json_string),
    "conntrackCount": ${conntrack_count:-0},
    "conntrackMax": ${conntrack_max:-0},
    "resourceMetricsPresent": $(json_bool test -s /var/lib/node_exporter/textfile_collector/hyperspace_gate_resources.prom),
    "resourceMetricsExposed": $(json_bool node_exporter_exposes_resource_metrics),
    "firewallRulesPersisted": $(json_bool gate_firewall_rules_persisted),
    "ufwActive": $(json_bool bash -c 'ufw status 2>/dev/null | grep -q "^Status: active"')
  },
  "doublezeroStatus": $(printf '%s' "$doublezero_status" | json_string),
  "chronyTracking": $(printf '%s' "$chrony_tracking" | json_string)
}
JSON

if [[ "${REQUIRE_DEPLOYMENT_READY}" == "true" ]]; then
  systemctl is-active --quiet hyperspace-gate-agent.service
  test -x /usr/local/sbin/hyperspace-gate-agent-release
  /usr/local/bin/hyperspace-gate-agent --self-test >/dev/null
fi
REMOTE
)"

if [[ "$dry_run" == true ]]; then
  printf 'ssh %q %q DZ_ENV=%q REQUIRE_DEPLOYMENT_READY=%q bash -s <<REMOTE\n%s\nREMOTE\n' \
    "${ssh_args[*]}" "${ssh_user}@${host}" "$dz_env" "$require_deployment_ready" "$remote_script"
  exit 0
fi

ssh "${ssh_args[@]}" "${ssh_user}@${host}" "DZ_ENV=$(printf '%q' "$dz_env") REQUIRE_DEPLOYMENT_READY=$(printf '%q' "$require_deployment_ready") bash -s" <<<"$remote_script"
